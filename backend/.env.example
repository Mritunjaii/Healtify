# Port (Assigned automatically by Render in cloud)
PORT=5000

# MongoDB Connection String (e.g. from MongoDB Atlas Free Tier)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/healtify?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/healtify

# JWT Signing Secret (Render can generate this automatically)
JWT_SECRET=healtify_wellness_journal_secret_key_2026

# Google Gemini API Key (for Cloud AI Companion)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama Inference (optional, defaults to local 11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
